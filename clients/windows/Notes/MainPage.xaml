<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Notes.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Notes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12" MaxWidth="760">
            <TextBlock Text="Editor M0" Style="{StaticResource TitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Undo" Click="UndoClick" />
                <Button Content="Redo" Click="RedoClick" />
                <Button Content="Patch other (F6)" Click="PatchOtherClick" />
                <Button Content="Patch active (F7)" Click="PatchActiveClick" />
                <Button Content="Replay fixture" Click="ReplayClick" />
            </StackPanel>
            <TextBlock x:Name="Status" TextWrapping="Wrap" />
            <StackPanel x:Name="Blocks" Spacing="8" />
        </StackPanel>
    </ScrollViewer>
</Page>
